<?xml version="1.0" encoding="utf-8"?><!--
   Reglas de respaldo automático para Android 11 y anteriores.
   Android 12+ usa data_extraction_rules.xml (mantener ambos archivos iguales).
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- Estado de la licencia en la nube: se cifra con una llave del Keystore que no viaja en el
         respaldo, y restaurarlo podría deshacer un bloqueo. Todo lo demás se respalda como antes. -->
    <exclude domain="sharedpref" path="licencia_nube.xml" />
</full-backup-content>
